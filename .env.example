# Telegram Bot Token from @BotFather
BOT_TOKEN=your-bot-token-here

# Channel ID where listings are published (e.g. -1001234567890)
CHANNEL_ID=-1001234567890

# Database path
DB_PATH=store.db

# Default language: en or ru
DEFAULT_LANGUAGE=ru

# Bot mode: polling or webhook
MODE=polling

# Webhook settings (only needed if MODE=webhook)
WEBHOOK_URL=https://your-domain.com
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8443
WEBHOOK_PATH=/webhook

# Photo limits
MAX_PHOTOS=10
MIN_PHOTOS=1
